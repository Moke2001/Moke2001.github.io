{
  "name": "eureka-studio-visitor-log",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "logs": "wrangler d1 execute DB --remote --file queries/recent.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.159.0"
  }
}
